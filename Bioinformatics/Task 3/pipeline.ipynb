## Protein Structure prediction + reporting the features
- --> Hemoglobin Uniprot P69905
# import 
import os, sys, json, time, io, subprocess, warnings, shutil
from pathlib import Path

import requests
import numpy as np
import matplotlib
matplotlib.use('Agg') 
import matplotlib.pyplot as plt
from matplotlib.patches import Patch

from Bio.PDB import PDBParser, Superimposer, PDBIO, Select
from Bio.PDB.Polypeptide import is_aa, PPBuilder
from Bio.SeqUtils import seq1, seq3

# Paths
DOWNLOAD_DIR = Path('download')
WORK_DIR = Path('work')
DOWNLOAD_DIR.mkdir(parents=True, exist_ok=True)
WORK_DIR.mkdir(parents=True, exist_ok=True)

# Target
UNIPROT_ID = 'P69905'

# Fonts
plt.rcParams['font.family'] = ['DejaVu Serif', 'Liberation Serif', 'Times New Roman']
plt.rcParams['axes.unicode_minus'] = False
plt.rcParams['figure.dpi'] = 110
# Fetch from UniProt
uniprot_fasta_url = f'https://rest.uniprot.org/uniprotkb/{UNIPROT_ID}.fasta'
uniprot_meta_url  = f'https://rest.uniprot.org/uniprotkb/{UNIPROT_ID}.json'

resp = requests.get(uniprot_fasta_url, timeout=30)
resp.raise_for_status()
fasta_text = resp.text

# Parse
lines = fasta_text.strip().split('\n')
header = lines[0]
seq = ''.join(lines[1:])
# save
fasta_path = WORK_DIR / f'{UNIPROT_ID}.fasta'
fasta_path.write_text(fasta_text)
# metadata fetch 
m = requests.get(uniprot_meta_url, timeout=30).json()
protein_desc = (m.get('proteinDescription', {})
                  .get('recommendedName', {})
                  .get('fullName', {})
                  .get('value', 'Hemoglobin subunit alpha'))
organism = m.get('organism', {}).get('scientificName', 'Homo sapiens')
gene_names = []
for g in m.get('genes', []):
    if 'geneName' in g:
        gene_names.append(g['geneName']['value'])
gene_str = ', '.join(gene_names) if gene_names else 'N/A'

metadata = {
    'uniprot_id': UNIPROT_ID,
    'protein_name': protein_desc,
    'organism': organism,
    'gene_names': gene_str,
    'sequence_length': len(seq),
    'sequence': seq,
    'header': header,
}
(WORK_DIR / f'{UNIPROT_ID}_meta.json').write_text(json.dumps(metadata, indent=2))

# Alphafold DB for prediction retrieval

afdb_api_url = f'https://alphafold.ebi.ac.uk/api/prediction/{UNIPROT_ID}'
af_resp = requests.get(afdb_api_url, timeout=30)
af_resp.raise_for_status()
af_data = af_resp.json()[0]  
latest_ver      = af_data['latestVersion']
pdb_url        = af_data['pdbUrl']
global_plddt   = af_data['globalMetricValue']
frac_very_high = af_data['fractionPlddtVeryHigh']
frac_confident = af_data['fractionPlddtConfident']
frac_low       = af_data['fractionPlddtLow']
frac_very_low  = af_data['fractionPlddtVeryLow']
tool_used      = af_data.get('toolUsed', 'AlphaFold')
model_created  = af_data.get('modelCreatedDate', 'N/A')

# Download
afdb_pdb_path = DOWNLOAD_DIR / f'AF-{UNIPROT_ID}-F1-model_v{latest_ver}.pdb'
r = requests.get(pdb_url, timeout=60)
r.raise_for_status()
afdb_pdb_path.write_bytes(r.content)
afdb_info = {
    'uniprot_id'       : UNIPROT_ID,
    'version'          : latest_ver,
    'pdb_url'          : pdb_url,
    'tool_used'        : tool_used,
    'model_created'    : model_created,
    'global_plddt'     : global_plddt,
    'fraction_very_high': frac_very_high,
    'fraction_confident' : frac_confident,
    'fraction_low'       : frac_low,
    'fraction_very_low'  : frac_very_low,
    'local_path'        : str(afdb_pdb_path),
}
(WORK_DIR / 'afdb_info.json').write_text(json.dumps(afdb_info, indent=2))
# Query SWISS MODEL 

swiss_api_url = f'https://swissmodel.expasy.org/repository/uniprot/{UNIPROT_ID}.json'
sw = requests.get(swiss_api_url, timeout=30)
sw.raise_for_status()
sw_json = sw.json()

sw_structures = sw_json['result']['structures']
print(f'Total SWISS-MODEL Repository structures for {UNIPROT_ID}: {len(sw_structures)}')

# Filter >= 99% coverage 
def date_key(s):
    d = s.get('created_date', '1900-01-01')
    return d if isinstance(d, str) else '1900-01-01'

full_cov = [s for s in sw_structures if s.get('coverage', 0) >= 0.99]

candidates = sorted(full_cov, key=date_key, reverse=True)
top_swiss = candidates[0] if candidates else sorted(sw_structures, key=date_key, reverse=True)[0]

ligand_summary = []
for lc in top_swiss.get('ligand_chains', []):
    cnt = lc.get('count', 1)
    for lig in lc.get('ligands', []):
        hetid = lig.get('hetid', '?')
        desc  = lig.get('description', '?')
        ligand_summary.append(f"{hetid} ({desc}, count={cnt})")

swiss_pdb_path = DOWNLOAD_DIR / f'SWISSMODEL-{UNIPROT_ID}-{top_swiss["template"]}.pdb'
r = requests.get(top_swiss['coordinates'], timeout=60)
r.raise_for_status()
swiss_pdb_path.write_bytes(r.content)

swiss_info = {
    'uniprot_id'      : UNIPROT_ID,
    'template'        : top_swiss['template'],
    'method'          : top_swiss['method'],
    'coverage'        : top_swiss['coverage'],
    'created_date'    : top_swiss['created_date'],
    'coordinates_url' : top_swiss['coordinates'],
    'oligo_state'     : top_swiss.get('oligo-state'),
    'ligand_chains'   : top_swiss.get('ligand_chains', []),
    'in_complex_with' : top_swiss.get('in_complex_with', {}),
    'local_path'      : str(swiss_pdb_path),
}
(WORK_DIR / 'swiss_info.json').write_text(json.dumps(swiss_info, indent=2))

# Structural feature analysis
parser = PDBParser(QUIET=True)
afdb_struct   = parser.get_structure('AFDB',   str(afdb_pdb_path))
swiss_struct  = parser.get_structure('SWISS',  str(swiss_pdb_path))
afdb_plddt = []
afdb_residues = []
# Per residue 


for model in afdb_struct:
    for chain in model:
        for res in chain:
            if is_aa(res):
                bfacs = [a.get_bfactor() for a in res.get_atoms()]
                if bfacs:
                    plddt_val = float(np.mean(bfacs))
                    afdb_plddt.append(plddt_val)
                    resname = res.get_resname()
                    resnum  = res.get_id()[1]
                    afdb_residues.append({
                        'resnum': resnum,
                        'resname': seq1(resname),
                        'plddt': plddt_val,
                    })
    break  


n_res = len(afdb_plddt)
mean_plddt = float(np.mean(afdb_plddt))
bins = {
    'Very High (>90)' : sum(1 for p in afdb_plddt if p >= 90),
    'Confident (70-90)': sum(1 for p in afdb_plddt if 70 <= p < 90),
    'Low (50-70)'     : sum(1 for p in afdb_plddt if 50 <= p < 70),
    'Very Low (<50)'  : sum(1 for p in afdb_plddt if p < 50),
}

# Secondary structure via PyMOL 
print('\nRunning PyMOL dss for secondary structure assignment...')
import pymol
from pymol import cmd
pymol.finish_launching(['pymol', '-cqk'])
cmd.reinitialize()
cmd.load(str(afdb_pdb_path), 'afdb')
cmd.dss('afdb')

space = {'ss_list': []}
cmd.iterate('afdb and name CA', 'ss_list.append((resi, resn, ss, chain))', space=space)
# Convert 
ss_records = []
for r in space['ss_list']:
    resi_str, resn, ss, chain = r
    try:
        resi = int(resi_str)
    except (ValueError, TypeError):
        # Strip non-digit chars from the end
        s = str(resi_str)
        digits = ''
        for ch in s:
            if ch.isdigit(): digits += ch
            else: break
        resi = int(digits) if digits else 0
    ss_records.append((resi, resn, ss, chain))

# Tally
ss_count = {'H': 0, 'G': 0, 'I': 0, 'E': 0, 'B': 0, 'T': 0, 'S': 0, 'L': 0, '-': 0}
for r in ss_records:
    ss = r[2] if r[2] else '-'
    ss_count[ss] = ss_count.get(ss, 0) + 1
n_helix   = ss_count.get('H', 0) + ss_count.get('G', 0) + ss_count.get('I', 0)
n_sheet   = ss_count.get('E', 0) + ss_count.get('B', 0)
n_loop    = ss_count.get('T', 0) + ss_count.get('S', 0) + ss_count.get('L', 0) + ss_count.get('-', 0)

# Identify contiguous helical segments
segments, cur = [], []
prev_ss, prev_resi = None, None
for resi, resn, ss, chain in ss_records:
    if ss == 'H':
        if cur and prev_ss == 'H' and resi == prev_resi + 1:
            cur.append((resi, seq1(resn)))
        else:
            if cur and len(cur) >= 4:
                segments.append(cur)
            cur = [(resi, seq1(resn))]
    else:
        if cur and len(cur) >= 4:
            segments.append(cur)
        cur = []
    prev_ss, prev_resi = ss, resi
if cur and len(cur) >= 4:
    segments.append(cur)

# RMSD between AFDB and SWISS-MODEL 
def get_ca_atoms(struct, chain_id=None):
    out = {}
    for model in struct:
        for chain in model:
            if chain_id and chain.id != chain_id:
                continue
            for res in chain:
                if is_aa(res) and 'CA' in res:
                    out[res.get_id()[1]] = res['CA']
        break
    return out

afdb_ca  = get_ca_atoms(afdb_struct)
swiss_ca = get_ca_atoms(swiss_struct)
common = sorted(set(afdb_ca.keys()) & set(swiss_ca.keys()))

af_atoms  = [afdb_ca[i]  for i in common]
sw_atoms  = [swiss_ca[i] for i in common]
sup = Superimposer()
sup.set_atoms(af_atoms, sw_atoms)
rmsd = sup.rms
# Ramachandran phi/psi
ppb = PPBuilder()
peptides = list(ppb.build_peptides(afdb_struct[0]))
phi_psi = []
for pp in peptides:
    for phi, psi in pp.get_phi_psi_list():
        if phi is not None and psi is not None:
            phi_psi.append((np.degrees(phi), np.degrees(psi)))

def rama_bin(phi, psi):
    if -180 <= phi < -30 and -90 <= psi < 50:   return 'favoured'
    if -150 <= phi < 30 and 90 <= psi <= 180:   return 'favoured'
    if 30 <= phi <= 90 and -90 <= psi <= 0:     return 'favoured'
    if -100 <= phi <= -40 and 120 <= psi <= 180: return 'favoured'
    return 'outlier'
bins_rama = {'favoured': 0, 'outlier': 0}
for phi, psi in phi_psi:
    bins_rama[rama_bin(phi, psi)] += 1
n_rama = sum(bins_rama.values())

analysis = {
    'n_residues'        : n_res,
    'mean_plddt'        : mean_plddt,
    'plddt_bins'        : bins,
    'ss_count'          : ss_count,
    'n_helix_residues'  : n_helix,
    'n_sheet_residues'  : n_sheet,
    'n_loop_residues'   : n_loop,
    'helix_segments'    : [{'start': s[0][0], 'end': s[-1][0], 'len': len(s)} for s in segments],
    'rmsd_afdb_swiss'   : float(rmsd),
    'common_ca_atoms'   : len(common),
    'rama_favoured_pct' : 100*bins_rama['favoured']/max(n_rama,1),
    'rama_outlier_pct'  : 100*bins_rama['outlier']/max(n_rama,1),
    'afdb_residues'     : afdb_residues,
}
(WORK_DIR / 'structural_analysis.json').write_text(json.dumps(analysis, indent=2, default=str))

